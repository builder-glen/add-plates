{
  // 정적 SPA를 Cloudflare에 올리기 위한 설정.
  // 서버 코드는 없다 — dist 폴더를 그대로 서빙할 뿐이다.
  "name": "add-plates",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    // 없는 경로로 들어와도 index.html 을 준다.
    // SPA 라 라우팅을 브라우저가 처리하기 때문이다.
    "not_found_handling": "single-page-application"
  },
  // 도메인 연결. custom_domain 이면 배포할 때 DNS 레코드까지 자동으로 만든다.
  // 대시보드에서 손으로 붙이지 않고 여기 두는 이유는, 설정이 코드에 남아야
  // 나중에 왜 이 주소인지 찾을 수 있기 때문이다.
  "routes": [
    { "pattern": "add-plates.dev", "custom_domain": true },
    { "pattern": "www.add-plates.dev", "custom_domain": true }
  ]
}
